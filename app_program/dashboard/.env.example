# No .env parser is used. Export variables in your shell before npm start.
WEB_BIND=127.0.0.1
WEB_PORT=3000
BROKER_BIND=127.0.0.1
BROKER_PORT=1883
# For LAN access, set WEB_BIND/BROKER_BIND=0.0.0.0 and REQUIRE:
# ADMIN_TOKEN=<strong unique random token>
# MQTT_USER=<unique username>
# MQTT_PASSWORD=<strong unique password>
# For final robot, set physical measured track width; simulator assumes 120mm
TRACK_WIDTH_MM=120

# To use Mosquitto instead of the built-in development broker:
# BROKER_EXTERNAL=1
# BROKER_HOST=127.0.0.1

# When simulation and hardware both publish, auto prefers hardware.
# DASHBOARD_SOURCE=auto (or sim / robot)

# All robot, simulator and dashboard publishers must use matching topics.
MQTT_NAMESPACE=g7/b1
ROBOT_ID=robot
# Persisted locally, not held only in the browser.
RECORDING_DIR=./recordings
# DO NOT enable these unless physically verified against controller/calibration.
LIVE_COMMANDS_ENABLED=0
LIVE_IMU_RECAL_ENABLED=0
